{
  "name": "isles-cartoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "perf": "node scripts/perf/perf.mjs",
    "shots": "node scripts/shots/shots.mjs",
    "map": "node scripts/map/map.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tweakpane/core": "2.0.5",
    "@types/three": "^0.186.0",
    "ktx2-encoder": "0.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
